{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact polynomial contraction certificate, version 1",
  "$comment": "Structural companion only. verify.py additionally checks cross-field dimension n, invertibility, positive radii, <=256 total terms, <=32 total degree per term, rational digit counts, byte size, duplicate JSON keys and numeric lexical types. No network schema loading is required by verify.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "variables", "polynomials", "center", "radii", "preconditioner"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "name": {"type": "string"},
    "variables": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}},
    "polynomials": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/term"}}},
    "center": {"$ref": "#/$defs/vector"},
    "radii": {"$ref": "#/$defs/vector"},
    "preconditioner": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/vector"}}
  },
  "$defs": {
    "rational": {"type": "string", "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$", "maxLength": 258},
    "vector": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/rational"}},
    "term": {
      "type": "object", "additionalProperties": false,
      "required": ["coefficient", "powers"],
      "properties": {
        "coefficient": {"$ref": "#/$defs/rational"},
        "powers": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "integer", "minimum": 0, "maximum": 32}}
      }
    }
  }
}
