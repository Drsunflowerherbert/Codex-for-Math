LPCertificates.input_feasible_iff {n r : ℕ} (P : InputProblem n r) (x : Fin n → ℝ) :
  InputFeasible P x ↔ Feasible (realProblem (normalizeInput P)) x
LPCertificates.input_objective_bound_iff {n r : ℕ} (P : InputProblem n r) (x y : Fin n → ℝ) :
  dot (realProblem (normalizeInput P)).c y ≤ dot (realProblem (normalizeInput P)).c x ↔ ObjectiveBound P x y
