  [inst_1 : NormedSpace ℝ E] [inst_2 : Fintype ι] (L : ι → E →L[ℝ] ℝ) (b : ι → ℝ),
  (∀ (v : E), v ≠ 0 → ∃ i, (L i) v ≠ 0) → StrictConvexOn ℝ Set.univ (ConvexApprox.barrier L b)
