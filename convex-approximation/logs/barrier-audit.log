@ConvexApprox.barrierHessian_nonneg : ∀ {E : Type u_1} {ι : Type u_2} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] [inst_2 : Fintype ι] (L : ι → E →L[ℝ] ℝ) (b : ι → ℝ) (x y : E),
  0 ≤ ((ConvexApprox.barrierHessian L b x) y) y
'ConvexApprox.barrierHessian_nonneg' depends on axioms: [propext, Classical.choice, Quot.sound]
@ConvexApprox.barrierHessian_pos_of_exists : ∀ {E : Type u_1} {ι : Type u_2} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] [inst_2 : Fintype ι] (L : ι → E →L[ℝ] ℝ) (b : ι → ℝ) (x y : E),
  (∃ i, (L i) y ≠ 0) → 0 < ((ConvexApprox.barrierHessian L b x) y) y
'ConvexApprox.barrierHessian_pos_of_exists' depends on axioms: [propext, Classical.choice, Quot.sound]
@ConvexApprox.barrierHessian_pos : ∀ {E : Type u_1} {ι : Type u_2} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] [inst_2 : Fintype ι] (L : ι → E →L[ℝ] ℝ) (b : ι → ℝ),
  (∀ (y : E), y ≠ 0 → ∃ i, (L i) y ≠ 0) → ∀ (x y : E), y ≠ 0 → 0 < ((ConvexApprox.barrierHessian L b x) y) y
'ConvexApprox.barrierHessian_pos' depends on axioms: [propext, Classical.choice, Quot.sound]
