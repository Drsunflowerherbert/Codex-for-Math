@ConvexApprox.barrier_supporting : ∀ {E : Type u_1} {ι : Type u_2} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] [inst_2 : Fintype ι] (L : ι → E →L[ℝ] ℝ) (b : ι → ℝ) (x y : E),
  ConvexApprox.barrier L b x + (ConvexApprox.barrierDeriv L b x) (y - x) ≤ ConvexApprox.barrier L b y
