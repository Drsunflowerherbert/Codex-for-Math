@ConvexApprox.hasFDerivAt_barrier : ∀ {E : Type u_1} {ι : Type u_2} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] [inst_2 : Fintype ι] (L : ι → E →L[ℝ] ℝ) (b : ι → ℝ) (x : E),
  HasFDerivAt (ConvexApprox.barrier L b) (ConvexApprox.barrierDeriv L b x) x
'ConvexApprox.hasFDerivAt_barrier' depends on axioms: [propext, Classical.choice, Quot.sound]
@ConvexApprox.hasFDerivAt_barrierDeriv : ∀ {E : Type u_1} {ι : Type u_2} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] [inst_2 : Fintype ι] (L : ι → E →L[ℝ] ℝ) (b : ι → ℝ) (x : E),
  HasFDerivAt (ConvexApprox.barrierDeriv L b) (ConvexApprox.barrierHessian L b x) x
'ConvexApprox.hasFDerivAt_barrierDeriv' depends on axioms: [propext, Classical.choice, Quot.sound]
@ConvexApprox.fderiv_barrier : ∀ {E : Type u_1} {ι : Type u_2} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E]
  [inst_2 : Fintype ι] (L : ι → E →L[ℝ] ℝ) (b : ι → ℝ) (x : E),
  fderiv ℝ (ConvexApprox.barrier L b) x = ConvexApprox.barrierDeriv L b x
'ConvexApprox.fderiv_barrier' depends on axioms: [propext, Classical.choice, Quot.sound]
@ConvexApprox.fderiv_barrierDeriv : ∀ {E : Type u_1} {ι : Type u_2} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] [inst_2 : Fintype ι] (L : ι → E →L[ℝ] ℝ) (b : ι → ℝ) (x : E),
  fderiv ℝ (ConvexApprox.barrierDeriv L b) x = ConvexApprox.barrierHessian L b x
'ConvexApprox.fderiv_barrierDeriv' depends on axioms: [propext, Classical.choice, Quot.sound]
@ConvexApprox.barrierDeriv_apply : ∀ {E : Type u_1} {ι : Type u_2} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] [inst_2 : Fintype ι] (L : ι → E →L[ℝ] ℝ) (b : ι → ℝ) (x y : E),
  (ConvexApprox.barrierDeriv L b x) y = ∑ i, Real.exp ((L i) x - b i) * (L i) y
'ConvexApprox.barrierDeriv_apply' depends on axioms: [propext, Classical.choice, Quot.sound]
@ConvexApprox.barrierHessian_apply : ∀ {E : Type u_1} {ι : Type u_2} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] [inst_2 : Fintype ι] (L : ι → E →L[ℝ] ℝ) (b : ι → ℝ) (x y z : E),
  ((ConvexApprox.barrierHessian L b x) y) z = ∑ i, Real.exp ((L i) x - b i) * (L i) y * (L i) z
'ConvexApprox.barrierHessian_apply' depends on axioms: [propext, Classical.choice, Quot.sound]
@ConvexApprox.barrierHessian_diag : ∀ {E : Type u_1} {ι : Type u_2} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] [inst_2 : Fintype ι] (L : ι → E →L[ℝ] ℝ) (b : ι → ℝ) (x y : E),
  ((ConvexApprox.barrierHessian L b x) y) y = ∑ i, Real.exp ((L i) x - b i) * (L i) y ^ 2
'ConvexApprox.barrierHessian_diag' depends on axioms: [propext, Classical.choice, Quot.sound]
@ConvexApprox.contDiff_barrier : ∀ {E : Type u_1} {ι : Type u_2} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] [inst_2 : Fintype ι] (L : ι → E →L[ℝ] ℝ) (b : ι → ℝ) {n : WithTop ℕ∞},
  ContDiff ℝ n (ConvexApprox.barrier L b)
'ConvexApprox.contDiff_barrier' depends on axioms: [propext, Classical.choice, Quot.sound]
@ConvexApprox.fderiv_fderiv_barrier : ∀ {E : Type u_1} {ι : Type u_2} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] [inst_2 : Fintype ι] (L : ι → E →L[ℝ] ℝ) (b : ι → ℝ) (x : E),
  fderiv ℝ (fun z => fderiv ℝ (ConvexApprox.barrier L b) z) x = ConvexApprox.barrierHessian L b x
'ConvexApprox.fderiv_fderiv_barrier' depends on axioms: [propext, Classical.choice, Quot.sound]
@ConvexApprox.barrierHessian_symmetric : ∀ {E : Type u_1} {ι : Type u_2} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] [inst_2 : Fintype ι] (L : ι → E →L[ℝ] ℝ) (b : ι → ℝ) (x y z : E),
  ((ConvexApprox.barrierHessian L b x) y) z = ((ConvexApprox.barrierHessian L b x) z) y
