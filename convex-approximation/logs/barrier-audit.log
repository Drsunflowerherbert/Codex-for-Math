@ConvexApprox.barrierDeriv_apply_pos_of_level : ∀ {E : Type u_1} {ι : Type u_2} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] [inst_2 : Fintype ι] (L : ι → E →L[ℝ] ℝ) (b : ι → ℝ) (p x : E) (c : ℝ),
  ConvexApprox.barrier L b p < c → ConvexApprox.barrier L b x = c → 0 < (ConvexApprox.barrierDeriv L b x) (x - p)
'ConvexApprox.barrierDeriv_apply_pos_of_level' depends on axioms: [propext, Classical.choice, Quot.sound]
@ConvexApprox.barrierDeriv_ne_zero_of_level : ∀ {E : Type u_1} {ι : Type u_2} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] [inst_2 : Fintype ι] (L : ι → E →L[ℝ] ℝ) (b : ι → ℝ) (p x : E) (c : ℝ),
  ConvexApprox.barrier L b p < c → ConvexApprox.barrier L b x = c → ConvexApprox.barrierDeriv L b x ≠ 0
'ConvexApprox.barrierDeriv_ne_zero_of_level' depends on axioms: [propext, Classical.choice, Quot.sound]
@ConvexApprox.closure_barrier_lt : ∀ {E : Type u_1} {ι : Type u_2} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] [inst_2 : Fintype ι] (L : ι → E →L[ℝ] ℝ) (b : ι → ℝ) (p : E) (c : ℝ),
  ConvexApprox.barrier L b p < c → closure {x | ConvexApprox.barrier L b x < c} = {x | ConvexApprox.barrier L b x ≤ c}
'ConvexApprox.closure_barrier_lt' depends on axioms: [propext, Classical.choice, Quot.sound]
@ConvexApprox.frontier_barrier_lt : ∀ {E : Type u_1} {ι : Type u_2} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] [inst_2 : Fintype ι] (L : ι → E →L[ℝ] ℝ) (b : ι → ℝ) (p : E) (c : ℝ),
  ConvexApprox.barrier L b p < c → frontier {x | ConvexApprox.barrier L b x < c} = {x | ConvexApprox.barrier L b x = c}
'ConvexApprox.frontier_barrier_lt' depends on axioms: [propext, Classical.choice, Quot.sound]
