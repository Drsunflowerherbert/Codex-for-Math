Egyptian.reciprocalSum : List ℕ → ℝ
Egyptian.odd_replacement_identity : ∀ (k : ℕ),
  (↑(2 * k + 1))⁻¹ + (↑(2 * k + 1))⁻¹ = (↑(k + 1))⁻¹ + (↑((2 * k + 1) * (k + 1)))⁻¹
Egyptian.even_replacement_identity : ∀ (k : ℕ), 0 < k → (↑(2 * k))⁻¹ + (↑(2 * k))⁻¹ = (↑(k + 1))⁻¹ + (↑(k * (k + 1)))⁻¹
Egyptian.odd_replacement_growth : ∀ (k : ℕ), 1 ≤ k → 2 * (2 * k + 1) < k + 1 + (2 * k + 1) * (k + 1)
Egyptian.even_replacement_growth : ∀ (k : ℕ), 2 ≤ k → 2 * (2 * k) < k + 1 + k * (k + 1)
Egyptian.finite_sortedRepresentations : ∀ (n : ℕ) (x : ℝ), (Egyptian.sortedRepresentations n x).Finite
@Egyptian.duplicate_extraction : ∀ {l : List ℕ}, ¬l.Nodup → ∃ a t, l.Perm (a :: a :: t)
@Egyptian.duplicate_ge_three : ∀ {a : ℕ} {t : List ℕ}, 0 < a → Egyptian.reciprocalSum (a :: a :: t) < 1 → 3 ≤ a
Egyptian.replacement_exists : ∀ (d : ℕ),
  3 ≤ d → ∃ a b, 0 < a ∧ 0 < b ∧ (↑a)⁻¹ + (↑b)⁻¹ = (↑d)⁻¹ + (↑d)⁻¹ ∧ d + d < a + b
@Egyptian.duplicate_cleanup : ∀ {l : List ℕ},
  (∀ d ∈ l, 0 < d) →
    Egyptian.reciprocalSum l < 1 →
      ¬l.Nodup →
        ∃ out,
          (∀ d ∈ out, 0 < d) ∧
            out.length = l.length ∧ Egyptian.reciprocalSum out = Egyptian.reciprocalSum l ∧ l.sum < out.sum
@Egyptian.canonical_mem : ∀ {l : List ℕ},
  (∀ d ∈ l, 0 < d) → Egyptian.canonical l ∈ Egyptian.sortedRepresentations l.length (Egyptian.reciprocalSum l)
@Egyptian.sorted_duplicate_cleanup : ∀ {n : ℕ} {x : ℝ} {current : List ℕ},
  current ∈ Egyptian.sortedRepresentations n x →
    x < 1 → ¬current.Nodup → ∃ next ∈ Egyptian.sortedRepresentations n x, current.sum < next.sum
@Egyptian.exact_length_distinct : ∀ {input : List ℕ},
  (∀ d ∈ input, 0 < d) →
    0 < Egyptian.reciprocalSum input →
      Egyptian.reciprocalSum input < 1 →
        ∃ out,
          (∀ d ∈ out, 0 < d) ∧
            out.Nodup ∧ out.length = input.length ∧ Egyptian.reciprocalSum out = Egyptian.reciprocalSum input
@Egyptian.finite_increasing_weight_wellFounded : ∀ {α : Type u_1} (s : Set α),
  s.Finite → ∀ (weight : α → ℕ), WellFounded fun next current => weight ↑current < weight ↑next
Egyptian.cleanup_wellFounded : ∀ (n : ℕ) (x : ℝ), WellFounded fun next current => (↑current).sum < (↑next).sum
@Egyptian.two_positive_denominators_sum_one : ∀ {a b : ℕ}, 0 < a → 0 < b → (↑a)⁻¹ + (↑b)⁻¹ = 1 → a = 2 ∧ b = 2
Egyptian.no_distinct_two_term_one : ¬∃ l, (∀ d ∈ l, 0 < d) ∧ l.Nodup ∧ l.length = 2 ∧ Egyptian.reciprocalSum l = 1
Egyptian.boundary_counterexample : (∀ d ∈ [2, 2], 0 < d) ∧
  Egyptian.reciprocalSum [2, 2] = 1 ∧
    ¬∃ out,
        (∀ d ∈ out, 0 < d) ∧
          out.Nodup ∧ out.length = [2, 2].length ∧ Egyptian.reciprocalSum out = Egyptian.reciprocalSum [2, 2]
'Egyptian.odd_replacement_identity' depends on axioms: [propext, Classical.choice, Quot.sound]
'Egyptian.even_replacement_identity' depends on axioms: [propext, Classical.choice, Quot.sound]
'Egyptian.finite_sortedRepresentations' depends on axioms: [propext, Classical.choice, Quot.sound]
'Egyptian.duplicate_cleanup' depends on axioms: [propext, Classical.choice, Quot.sound]
'Egyptian.sorted_duplicate_cleanup' depends on axioms: [propext, Classical.choice, Quot.sound]
'Egyptian.exact_length_distinct' depends on axioms: [propext, Classical.choice, Quot.sound]
'Egyptian.cleanup_wellFounded' depends on axioms: [propext, Classical.choice, Quot.sound]
'Egyptian.no_distinct_two_term_one' depends on axioms: [propext, Classical.choice, Quot.sound]
'Egyptian.boundary_counterexample' depends on axioms: [propext, Classical.choice, Quot.sound]
