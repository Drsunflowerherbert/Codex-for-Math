Egyptian.reciprocalSum : List ℕ → ℝ
Egyptian.reciprocalSum_nil : Egyptian.reciprocalSum [] = 0
Egyptian.reciprocalSum_cons : ∀ (a : ℕ) (l : List ℕ),
  Egyptian.reciprocalSum (a :: l) = (↑a)⁻¹ + Egyptian.reciprocalSum l
Egyptian.reciprocalSum_append : ∀ (l r : List ℕ),
  Egyptian.reciprocalSum (l ++ r) = Egyptian.reciprocalSum l + Egyptian.reciprocalSum r
@Egyptian.reciprocalSum_perm : ∀ {l r : List ℕ}, l.Perm r → Egyptian.reciprocalSum l = Egyptian.reciprocalSum r
Egyptian.reciprocalSum_nonneg : ∀ (l : List ℕ), 0 ≤ Egyptian.reciprocalSum l
@Egyptian.reciprocalSum_pos : ∀ {l : List ℕ}, (∀ d ∈ l, 0 < d) → l ≠ [] → 0 < Egyptian.reciprocalSum l
Egyptian.odd_replacement_identity : ∀ (k : ℕ),
  (↑(2 * k + 1))⁻¹ + (↑(2 * k + 1))⁻¹ = (↑(k + 1))⁻¹ + (↑((2 * k + 1) * (k + 1)))⁻¹
Egyptian.even_replacement_identity : ∀ (k : ℕ), 0 < k → (↑(2 * k))⁻¹ + (↑(2 * k))⁻¹ = (↑(k + 1))⁻¹ + (↑(k * (k + 1)))⁻¹
Egyptian.odd_replacement_growth : ∀ (k : ℕ), 1 ≤ k → 2 * (2 * k + 1) < k + 1 + (2 * k + 1) * (k + 1)
Egyptian.even_replacement_growth : ∀ (k : ℕ), 2 ≤ k → 2 * (2 * k) < k + 1 + k * (k + 1)
Egyptian.sortedRepresentations : ℕ → ℝ → Set (List ℕ)
@Egyptian.reciprocalSum_le_length_mul_inv : ∀ {a : ℕ},
  0 < a → ∀ (l : List ℕ), (∀ d ∈ l, a ≤ d) → Egyptian.reciprocalSum l ≤ ↑l.length * (↑a)⁻¹
Egyptian.finite_sortedRepresentations : ∀ (n : ℕ) (x : ℝ), (Egyptian.sortedRepresentations n x).Finite
@Egyptian.duplicate_extraction : ∀ {l : List ℕ}, ¬l.Nodup → ∃ (a : ℕ) (t : List ℕ), l.Perm (a :: a :: t)
@Egyptian.duplicate_ge_three : ∀ {a : ℕ} {t : List ℕ}, 0 < a → Egyptian.reciprocalSum (a :: a :: t) < 1 → 3 ≤ a
Egyptian.replacement_exists : ∀ (d : ℕ),
  3 ≤ d → ∃ (a : ℕ) (b : ℕ), 0 < a ∧ 0 < b ∧ (↑a)⁻¹ + (↑b)⁻¹ = (↑d)⁻¹ + (↑d)⁻¹ ∧ d + d < a + b
@Egyptian.duplicate_cleanup : ∀ {l : List ℕ},
  (∀ d ∈ l, 0 < d) →
    Egyptian.reciprocalSum l < 1 →
      ¬l.Nodup →
        ∃ (out : List ℕ),
          (∀ d ∈ out, 0 < d) ∧
            out.length = l.length ∧ Egyptian.reciprocalSum out = Egyptian.reciprocalSum l ∧ l.sum < out.sum
Egyptian.canonical : List ℕ → List ℕ
Egyptian.canonical_perm : ∀ (l : List ℕ), (Egyptian.canonical l).Perm l
@Egyptian.canonical_mem : ∀ {l : List ℕ},
  (∀ d ∈ l, 0 < d) → Egyptian.canonical l ∈ Egyptian.sortedRepresentations l.length (Egyptian.reciprocalSum l)
@Egyptian.sorted_duplicate_cleanup : ∀ {n : ℕ} {x : ℝ} {current : List ℕ},
  current ∈ Egyptian.sortedRepresentations n x →
    x < 1 → ¬current.Nodup → ∃ next ∈ Egyptian.sortedRepresentations n x, current.sum < next.sum
@Egyptian.exact_length_distinct : ∀ {input : List ℕ},
  (∀ d ∈ input, 0 < d) →
    0 < Egyptian.reciprocalSum input →
      Egyptian.reciprocalSum input < 1 →
        ∃ (out : List ℕ),
          (∀ d ∈ out, 0 < d) ∧
            out.Nodup ∧ out.length = input.length ∧ Egyptian.reciprocalSum out = Egyptian.reciprocalSum input
@Egyptian.bounded_increasing_weight_wellFounded : ∀ {α : Type u_1} (weight : α → ℕ) (bound : ℕ),
  (∀ (a : α), weight a ≤ bound) → WellFounded fun (next current : α) => weight current < weight next
@Egyptian.finite_increasing_weight_wellFounded : ∀ {α : Type u_1} (s : Set α),
  s.Finite → ∀ (weight : α → ℕ), WellFounded fun (next current : ↑s) => weight ↑current < weight ↑next
Egyptian.cleanup_wellFounded : ∀ (n : ℕ) (x : ℝ),
  WellFounded fun (next current : ↑(Egyptian.sortedRepresentations n x)) => (↑current).sum < (↑next).sum
@Egyptian.two_positive_denominators_sum_one : ∀ {a b : ℕ}, 0 < a → 0 < b → (↑a)⁻¹ + (↑b)⁻¹ = 1 → a = 2 ∧ b = 2
Egyptian.no_distinct_two_term_one : ¬∃ (l : List ℕ),
    (∀ d ∈ l, 0 < d) ∧ l.Nodup ∧ l.length = 2 ∧ Egyptian.reciprocalSum l = 1
Egyptian.boundary_counterexample : (∀ d ∈ [2, 2], 0 < d) ∧
  Egyptian.reciprocalSum [2, 2] = 1 ∧
    ¬∃ (out : List ℕ),
        (∀ d ∈ out, 0 < d) ∧
          out.Nodup ∧ out.length = [2, 2].length ∧ Egyptian.reciprocalSum out = Egyptian.reciprocalSum [2, 2]
Egyptian.commonNumerator : List ℕ → ℕ
@Egyptian.commonNumerator_spec : ∀ {l : List ℕ},
  (∀ d ∈ l, 0 < d) → ↑(Egyptian.commonNumerator l) = ↑l.prod * Egyptian.reciprocalSum l
@Egyptian.commonNumerator_eq_prod : ∀ {l : List ℕ},
  (∀ d ∈ l, 0 < d) → Egyptian.reciprocalSum l = 1 → Egyptian.commonNumerator l = l.prod
Egyptian.unit_split_identity : ∀ (d : ℕ), 0 < d → (↑d)⁻¹ = (↑(d + 1))⁻¹ + (↑(d * (d + 1)))⁻¹
Egyptian.factor_split_identity : ∀ (a b : ℕ), 0 < a → 0 < b → (↑(a * b))⁻¹ = (↑(a * (b + 1)))⁻¹ + (↑(a * b * (b + 1)))⁻¹
@Egyptian.prime_collision_obstruction : ∀ {d M : ℕ} {t : List ℕ},
  3 ≤ d →
    (∀ r ∈ d :: M :: t, 0 < r) →
      Egyptian.reciprocalSum (d :: M :: t) = 1 → (∀ r ∈ t, r < d) → M = d + 1 ∨ M = d * (d + 1) → ¬Nat.Prime d
@Egyptian.safe_split : ∀ {d u v : ℕ} {t : List ℕ},
  (∀ r ∈ d :: t, 0 < r) →
    (d :: t).Nodup →
      0 < u →
        0 < v →
          u ≠ v →
            u ∉ t →
              v ∉ t →
                (↑d)⁻¹ = (↑u)⁻¹ + (↑v)⁻¹ →
                  (∀ r ∈ u :: v :: t, 0 < r) ∧
                    (u :: v :: t).Nodup ∧
                      (u :: v :: t).length = (d :: t).length + 1 ∧
                        Egyptian.reciprocalSum (u :: v :: t) = Egyptian.reciprocalSum (d :: t)
@Egyptian.denominator_ge_two_of_one : ∀ {l : List ℕ},
  (∀ d ∈ l, 0 < d) → 2 ≤ l.length → Egyptian.reciprocalSum l = 1 → ∀ {d : ℕ}, d ∈ l → 2 ≤ d
Egyptian.padding_pair : ∀ (d M : ℕ),
  3 ≤ d →
    d < M →
      (M = d + 1 ∨ M = d * (d + 1) → ¬Nat.Prime d) →
        ∃ (u : ℕ) (v : ℕ), d < u ∧ u < v ∧ u ≠ M ∧ v ≠ M ∧ u ≤ M * (M + 1) ∧ v ≤ M * (M + 1) ∧ (↑d)⁻¹ = (↑u)⁻¹ + (↑v)⁻¹
@Egyptian.expose_top_two : ∀ {input : List ℕ},
  (∀ r ∈ input, 0 < r) →
    input.Nodup →
      3 ≤ input.length →
        Egyptian.reciprocalSum input = 1 →
          ∃ (M : ℕ) (d : ℕ) (t : List ℕ), input.Perm (M :: d :: t) ∧ 3 ≤ d ∧ d < M ∧ ∀ r ∈ t, r < d
@Egyptian.padding_from_top_two : ∀ {M d marker : ℕ} {t : List ℕ},
  (∀ r ∈ M :: d :: t, 0 < r) →
    (M :: d :: t).Nodup →
      Egyptian.reciprocalSum (M :: d :: t) = 1 →
        3 ≤ d →
          d < M →
            (∀ r ∈ t, r < d) →
              marker ∈ M :: d :: t →
                ∃ (out : List ℕ),
                  (∀ r ∈ out, 0 < r) ∧
                    out.Nodup ∧
                      out.length = (M :: d :: t).length + 1 ∧
                        Egyptian.reciprocalSum out = 1 ∧ marker ∈ out ∧ ∀ r ∈ out, r ≤ M * (M + 1)
@Egyptian.pad_one_preserving_denominator_bounded : ∀ {input : List ℕ} {marker B : ℕ},
  (∀ d ∈ input, 0 < d) →
    input.Nodup →
      3 ≤ input.length →
        Egyptian.reciprocalSum input = 1 →
          marker ∈ input →
            (∀ d ∈ input, d ≤ B) →
              ∃ (out : List ℕ),
                (∀ d ∈ out, 0 < d) ∧
                  out.Nodup ∧
                    out.length = input.length + 1 ∧
                      Egyptian.reciprocalSum out = 1 ∧ marker ∈ out ∧ ∀ d ∈ out, d ≤ B * (B + 1)
@Egyptian.pad_one_preserving_denominator : ∀ {input : List ℕ} {marker : ℕ},
  (∀ d ∈ input, 0 < d) →
    input.Nodup →
      3 ≤ input.length →
        Egyptian.reciprocalSum input = 1 →
          marker ∈ input →
            ∃ (out : List ℕ),
              (∀ d ∈ out, 0 < d) ∧
                out.Nodup ∧ out.length = input.length + 1 ∧ Egyptian.reciprocalSum out = 1 ∧ marker ∈ out
Egyptian.example_two_thirds : Egyptian.reciprocalSum [4, 4, 6] = 2 / 3 ∧
  Egyptian.reciprocalSum [3, 4, 12] = Egyptian.reciprocalSum [4, 4, 6] ∧
    [3, 4, 12].Nodup ∧ [3, 4, 12].length = [4, 4, 6].length
Egyptian.example_marker_loss : 6 ∈ [4, 4, 6] ∧
  6 ∉ [3, 4, 12] ∧ Egyptian.reciprocalSum [4, 4, 6] = Egyptian.reciprocalSum [3, 4, 12]
Egyptian.example_new_collisions : Egyptian.reciprocalSum [6, 10, 10, 30] = Egyptian.reciprocalSum [6, 6, 30, 30] ∧
  [6, 10, 10, 30].sum = 56 ∧ [6, 6, 30, 30].sum = 72
Egyptian.example_padding_product_collision : Egyptian.reciprocalSum [2, 6, 7, 14, 15, 20, 420] = 1 ∧
  Egyptian.reciprocalSum [2, 6, 7, 14, 15, 22, 220, 420] = 1 ∧
    [2, 6, 7, 14, 15, 22, 220, 420].Nodup ∧
      [2, 6, 7, 14, 15, 22, 220, 420].length = [2, 6, 7, 14, 15, 20, 420].length + 1 ∧
        420 ∈ [2, 6, 7, 14, 15, 22, 220, 420]
