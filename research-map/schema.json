{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Drsunflowerherbert/Codex-for-Math/research-map/schema.json",
  "title": "Research map first-edition catalog",
  "type": "object",
  "required": ["schema_version", "edition", "research_baseline_commit", "upstream_source_commit", "coverage", "families", "manuscripts", "claim_scope_audits", "scoped_results"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "edition": {"type": "string"},
    "research_baseline_commit": {"$ref": "#/$defs/sha"},
    "upstream_source_commit": {"$ref": "#/$defs/sha"},
    "coverage": {"type": "object"},
    "families": {"type": "array", "items": {"type": "object", "required": ["family_id", "field", "subfield", "problem_family_title", "source_url", "active_manuscript_count", "distinct_problem_count"], "properties": {"family_id": {"$ref": "#/$defs/family"}, "distinct_problem_count": {"type": "null"}}}},
    "manuscripts": {"type": "array", "items": {"$ref": "#/$defs/manuscript"}},
    "claim_scope_audits": {"type": "array", "items": {"type": "object"}},
    "scoped_results": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "family": {"type": "string", "pattern": "^[0-9]{3}$"},
    "manuscript": {
      "type": "object",
      "required": ["record_id", "record_type", "family_id", "field", "subfield", "problem_family_title", "manuscript_title", "source_commit", "source_path", "statement_summary", "statement_basis", "hypotheses", "hypotheses_status", "result_kind", "catalog_status", "reliability_tier", "evidence_review", "evidence_types", "formal_check_this_round", "independent_mathematical_validation", "established_acceptance", "informal_formal_correspondence", "source_urls", "version", "withdrawal", "verification_gaps", "learning_priority"],
      "properties": {
        "record_id": {"type": "string", "pattern": "^manuscript-[0-9a-f]{16}$"},
        "record_type": {"const": "upstream_manuscript"},
        "family_id": {"$ref": "#/$defs/family"},
        "source_commit": {"$ref": "#/$defs/sha"},
        "statement_summary": {"type": "string"},
        "hypotheses": {"type": "null"},
        "hypotheses_status": {"const": "not_exhaustively_extracted"},
        "result_kind": {"enum": ["full", "partial", "conditional", "counterexample", "technique", "unassessed"]},
        "catalog_status": {"enum": ["active", "withdrawn"]},
        "evidence_review": {"enum": ["metadata_only", "withdrawal_notice_review"]},
        "formal_check_this_round": {"const": "not_run"},
        "established_acceptance": {"const": "not_established"},
        "informal_formal_correspondence": {"const": "not_reviewed"},
        "source_urls": {"type": "array", "minItems": 2, "items": {"type": "string", "format": "uri"}},
        "evidence_types": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "verification_gaps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "version": {"type": "object"},
        "withdrawal": {"type": ["object", "null"]}
      }
    }
  }
}
