PositiveBlocks.HasCommonSupportNormalForm.rank_eq.{u_1, u_2} {m : Type u_1} {n : Type u_2} [Fintype m] [Fintype n]
  {A : Matrix m m ℂ} {B : Matrix m n ℂ} {C : Matrix n n ℂ} (h : PositiveBlocks.HasCommonSupportNormalForm A B C) :
  A.rank = B.rank ∧ A.rank = C.rank ∧ 0 < A.rank ∧ A.rank ≤ Fintype.card m ∧ A.rank ≤ Fintype.card n
PositiveBlocks.HasCommonSupportNormalForm.exists_rank_witness.{u_1, u_2} {m : Type u_1} {n : Type u_2} [Fintype m]
  [Fintype n] {A : Matrix m m ℂ} {B : Matrix m n ℂ} {C : Matrix n n ℂ}
  (h : PositiveBlocks.HasCommonSupportNormalForm A B C) :
  ∃ U V H t,
    H.PosDef ∧
