PositiveBlocks.gram_product_eq_rank_eq.{u_1, u_2, u_5} {m : Type u_1} {n : Type u_2} [Fintype m] [Fintype n]
  {r : Type u_5} [Fintype r] [DecidableEq r] (X : Matrix r m ℂ) (Y : Matrix r n ℂ) (hX0 : X ≠ 0) (hY0 : Y ≠ 0)
