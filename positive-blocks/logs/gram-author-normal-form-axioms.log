PositiveBlocks.HasCommonSupportNormalForm.exists_normRatio_witness.{u_1, u_2} {m : Type u_1} {n : Type u_2} [Fintype m]
  [Fintype n] {A : Matrix m m ℂ} {B : Matrix m n ℂ} {C : Matrix n n ℂ}
