@PositiveBlocks.block_hsNorm_product_eq_exists_bounded_normalForm.{u_1,
    u_2} : ∀ {m : Type u_1} {n : Type u_2} [inst : Fintype.{u_1} m] [inst_1 : Fintype.{u_2} n]
  {A : Matrix.{u_1, u_1, 0} m m Complex} {B : Matrix.{u_1, u_2, 0} m n Complex} {C : Matrix.{u_2, u_2, 0} n n Complex},
  Matrix.PosSemidef.{max u_1 u_2, 0}
      (Matrix.fromBlocks.{u_1, u_2, u_1, u_2, 0} A B (Matrix.conjTranspose.{0, u_1, u_2} B) C) →
    Ne.{u_1 + 1} A 0 →
      Ne.{u_2 + 1} C 0 →
        Eq.{1} (HPow.hPow.{0, 0, 0} (PositiveBlocks.hsNorm.{u_1, u_2} B) 2)
            (HMul.hMul.{0, 0, 0} (PositiveBlocks.hsNorm.{u_1, u_1} A) (PositiveBlocks.hsNorm.{u_2, u_2} C)) →
          ∃ k,
            ∃ (_ : LT.lt.{0} 0 k) (_ : LE.le.{0} k (min.{0} (Fintype.card.{u_1} m) (Fintype.card.{u_2} n))),
              ∃ U V H t,
                And (Matrix.PosDef.{0, 0} H)
                  (And (LT.lt.{0} 0 t)
                    (And (Eq.{1} (HMul.hMul.{u_1, u_1, 0} (Matrix.conjTranspose.{0, u_1, 0} U) U) 1)
                      (And (Eq.{1} (HMul.hMul.{u_2, u_2, 0} (Matrix.conjTranspose.{0, u_2, 0} V) V) 1)
                        (And
                          (Eq.{u_1 + 1} A
                            (HMul.hMul.{u_1, u_1, u_1} (HMul.hMul.{u_1, 0, u_1} U H)
                              (Matrix.conjTranspose.{0, u_1, 0} U)))
                          (And
                            (Eq.{max (u_1 + 1) (u_2 + 1)} B
                              (HSMul.hSMul.{0, max u_1 u_2, max u_1 u_2} (Real.sqrt t)
                                (HMul.hMul.{u_1, u_2, max u_1 u_2} (HMul.hMul.{u_1, 0, u_1} U H)
                                  (Matrix.conjTranspose.{0, u_2, 0} V))))
                            (Eq.{u_2 + 1} C
                              (HSMul.hSMul.{0, u_2, u_2} t
                                (HMul.hMul.{u_2, u_2, u_2} (HMul.hMul.{u_2, 0, u_2} V H)
                                  (Matrix.conjTranspose.{0, u_2, 0} V)))))))))
