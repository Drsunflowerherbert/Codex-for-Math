  (hc : ∀ (q : ℕ), 0 < q → ∀ (p : ℤ), c * ↑q ^ (1 - α) ≤ |↑q * Real.pi - ↑p|) :
  TangentLimit.blockDelta c α N ≤ |TangentLimit.poleOffset n - TangentLimit.poleOffset m|
