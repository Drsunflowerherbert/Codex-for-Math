  Filter.Tendsto (fun n => Real.tan ↑n / ↑n ^ 3) Filter.atTop (nhds 0)
TangentLimit.tan_div_cube_positive_tendsto_zero (h : TangentLimit.PiDiophantine) :
  Filter.Tendsto (fun n => Real.tan ↑(n + 1) / ↑(n + 1) ^ 3) Filter.atTop (nhds 0)
