import TransportSharpness
import EvidenceHarness

/-! Same Lean kernel local-declaration replay against imported dependencies.
This is a separate phase from expected type and axiom checking; it does not
recheck the imported Mathlib proof bodies or use an independent kernel. -/
#evidence_replay [Mathlib, EvidenceHarness] targets [
  TransportSharpness.Atom,
  TransportSharpness.Plan,
  TransportSharpness.mass,
  TransportSharpness.IsCoupling,
  TransportSharpness.cost,
  TransportSharpness.matching,
  TransportSharpness.sourcePoint,
  TransportSharpness.targetPoint,
  TransportSharpness.sqCost,
  TransportSharpness.projectedCost,
  TransportSharpness.commonSource,
  TransportSharpness.Admissible,
  TransportSharpness.mapSquared,
  TransportSharpness.pCost,
  TransportSharpness.projectedPCost,
  TransportSharpness.mapSize,
  TransportSharpness.targetDistance,
  TransportSharpness.ceiling,
  TransportSharpness.exponent,
  TransportSharpness.finite_dual_lower_bound,
  TransportSharpness.mass_positive,
  TransportSharpness.mass_sum,
  TransportSharpness.matching_coupling,
  TransportSharpness.sqCost_ge_projected,
  TransportSharpness.quadratic_lower_bound,
  TransportSharpness.matching_quadratic_cost,
  TransportSharpness.quadratic_minimum,
  TransportSharpness.commonSource_coupling,
  TransportSharpness.commonSource_cost,
  TransportSharpness.commonSource_strictly_costlier,
  TransportSharpness.shrinking_admissible,
  TransportSharpness.shrinking_costs,
  TransportSharpness.square_rpow_half,
  TransportSharpness.pCost_ge_projected,
  TransportSharpness.pCost_matching,
  TransportSharpness.pCost_minimum,
  TransportSharpness.exponent_negative,
  TransportSharpness.targetDistance_positive,
  TransportSharpness.targetDistance_power,
  TransportSharpness.targetDistance_shrinking,
  TransportSharpness.mapSize_shrinking_lower,
  TransportSharpness.shrinking_ratio_lower,
  TransportSharpness.ceiling_values,
  TransportSharpness.shrinking_exceeds_constant,
  TransportSharpness.W2_exceeds_constant,
  TransportSharpness.mapSize_fixed_lower,
  TransportSharpness.fixed_ratio_lower,
  TransportSharpness.fixed_mass_exceeds_constant]
